{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof Wall exhibit v1",
  "description": "Portable shape only. Use python3 -m proofwall validate for hashes, paths, roles and cross-field checks. Schema validation does not assess scientific truth or authorize publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "artifact_type",
    "status",
    "question",
    "method",
    "finding",
    "claim_scope",
    "limitations",
    "open_questions",
    "date",
    "provenance",
    "article",
    "files",
    "relations",
    "gardens",
    "publication",
    "sample"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "artifact_type": {
      "enum": [
        "proof",
        "experiment",
        "failed-attempt",
        "counterexample",
        "question",
        "correction"
      ]
    },
    "status": {
      "enum": [
        "mathematically-proved",
        "verified-finite-result",
        "experimental",
        "counterexample",
        "conjecture",
        "correction",
        "unresolved"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "finding": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "claim_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    },
    "open_questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      }
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authors",
        "origin",
        "change_note"
      ],
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "change_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      }
    },
    "article": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "media_type",
          "bytes",
          "sha256",
          "attribution",
          "rights",
          "license"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "role": {
            "enum": [
              "article",
              "original",
              "code",
              "data",
              "receipt",
              "proof"
            ]
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "rights": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "version",
          "reason"
        ],
        "properties": {
          "type": {
            "enum": [
              "related-to",
              "tests",
              "corrects",
              "supersedes",
              "contradicts",
              "uses"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        }
      }
    },
    "gardens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "rights",
        "license",
        "attribution"
      ],
      "properties": {
        "intent": {
          "enum": [
            "hold",
            "request-review"
          ]
        },
        "rights": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      }
    },
    "sample": {
      "type": "boolean"
    }
  }
}
